{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('owner').val() === auth.uid",
        "owner": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length < 80"
        },
        "created": { ".validate": "newData.isNumber()" },
        "closed": { ".validate": "newData.isBoolean()" },
        "game": { ".validate": "newData.isString() && newData.val().length < 1500000" },
        "gameT": { ".validate": "newData.isNumber()" },
        "pos": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['d','t']) && newData.child('d').isString() && newData.child('d').val().length < 600 && newData.child('t').isNumber()"
          }
        },
        "chat": {
          "$msg": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['d','t']) && newData.child('d').isString() && newData.child('d').val().length < 1400 && newData.child('t').isNumber()"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
